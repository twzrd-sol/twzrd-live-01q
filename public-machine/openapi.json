{
  "openapi": "3.1.0",
  "info": {
    "title": "TWZRD Live 0\u21921Q",
    "version": "1.3.0",
    "description": "Machine-readable operator board for intel.twzrd.xyz 0\u21921Q. Board 1.3.0: Path B runbook (metric semantics clarified), agent attestation, live day0 funnel, CF strategy (SPRAT fold). Prefer JSON over HTML. Pay decisions \u2192 intel preflight, not this API. Source: github.com/twzrd-sol/twzrd-live-01q",
    "contact": {
      "name": "TWZRD",
      "url": "https://twzrd.xyz"
    }
  },
  "servers": [
    {
      "url": "https://twzrd-live-01q-host.vercel.app",
      "description": "Public multi-agent host (twzrd-sol)"
    }
  ],
  "paths": {
    "/llms.txt": {
      "get": {
        "summary": "Agent start guide (markdown)",
        "operationId": "getLlmsTxt",
        "responses": {
          "200": {
            "description": "Markdown guide"
          }
        }
      }
    },
    "/path-b": {
      "get": {
        "summary": "Human Path B runbook UI (when full app deployed)",
        "operationId": "getPathBHuman",
        "responses": {
          "200": {
            "description": "HTML"
          }
        }
      }
    },
    "/attest": {
      "get": {
        "summary": "Human agent attestation demo UI (when full app deployed)",
        "operationId": "getAttestHuman",
        "responses": {
          "200": {
            "description": "HTML"
          }
        }
      }
    },
    "/api/path-b": {
      "get": {
        "summary": "Path B external integration runbook JSON",
        "operationId": "getPathB",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "md",
                "markdown",
                "txt"
              ]
            },
            "description": "md/markdown/txt returns markdown; default json"
          }
        ],
        "responses": {
          "200": {
            "description": "twzrd.path_b_runbook/v1 \u2014 includes metric_semantics (buyer refuse \u2260 day0.gate_evals)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/attestation": {
      "get": {
        "summary": "Agent attestation demo pack (Schultz-shaped who/scope/fresh/decision)",
        "operationId": "getAttestation",
        "responses": {
          "200": {
            "description": "twzrd.agent_attestation/v1 \u2014 sample cards are fictional:true",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/board": {
      "get": {
        "summary": "Full live board snapshot",
        "operationId": "getBoard",
        "parameters": [
          {
            "name": "phase",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "truth",
                "wedge",
                "proof",
                "distribution",
                "convert"
              ]
            }
          },
          {
            "name": "horizon",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "this_week",
                "this_month",
                "quarter"
              ]
            }
          },
          {
            "name": "impact",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "critical",
                "high",
                "medium"
              ]
            }
          },
          {
            "name": "done",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated move ids treated as done (affects next_actions when server supports it)"
          }
        ],
        "responses": {
          "200": {
            "description": "twzrd.live_board/v1 \u2014 includes live, path_b_runbook, attestation, cf_strategy, moves (filtered when query params set)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/board/status": {
      "get": {
        "summary": "Compact status",
        "operationId": "getBoardStatus",
        "responses": {
          "200": {
            "description": "twzrd.live_board_status/v1"
          }
        }
      }
    },
    "/api/board/moves": {
      "get": {
        "summary": "Playbook moves",
        "operationId": "getBoardMoves",
        "parameters": [
          {
            "name": "phase",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "horizon",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "impact",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Moves list (filtered when query params set)"
          }
        }
      }
    },
    "/api/intel-health": {
      "get": {
        "summary": "Proxied intel.twzrd.xyz/health",
        "operationId": "getIntelHealth",
        "responses": {
          "200": {
            "description": "Upstream health + day0"
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This OpenAPI document",
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1"
          }
        }
      }
    }
  }
}